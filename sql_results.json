    {
      "id": "Q09",
      "section": "C. GROUP BY and aggregations",
      "title": "Revenue at risk (CASE grouping)",
      "question": "What share of order value is delivered, still in flight, or lost to cancellations and returns?",
      "sql": "SELECT CASE WHEN OrderStatus IN ('Cancelled', 'Returned') THEN 'At risk (Cancelled or Returned)'\n            WHEN OrderStatus = 'Delivered'                THEN 'Delivered'\n            ELSE 'In flight (Pending or Shipped)' END                      AS status_group,\n       COUNT(*)                                                           AS orders,\n       ROUND(SUM(TotalPrice), 2)                                          AS order_value,\n       ROUND(100.0 * SUM(TotalPrice) / (SELECT SUM(TotalPrice) FROM orders), 1) AS pct_of_value\nFROM orders\nGROUP BY status_group\nORDER BY order_value DESC;",
      "rows": 3,
      "result": [
        {
          "status_group": "At risk (Cancelled or Returned)",
          "orders": 497,
          "order_value": 519673.91,
          "pct_of_value": 41.1
        },
        {
          "status_group": "In flight (Pending or Shipped)",
