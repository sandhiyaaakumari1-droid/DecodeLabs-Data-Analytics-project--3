    {
      "id": "Q14",
      "section": "D. Time trends",
      "title": "First-half revenue, year over year (CTE + window function)",
      "question": "Is like-for-like (Jan to Jun) revenue growing or shrinking?",
      "sql": "WITH h1 AS (\n    SELECT strftime('%Y', Date) AS year,\n           COUNT(*)             AS orders,\n           SUM(TotalPrice)      AS revenue\n    FROM orders\n    WHERE CAST(strftime('%m', Date) AS INTEGER) <= 6\n    GROUP BY strftime('%Y', Date)\n)\nSELECT year,\n       orders,\n       ROUND(revenue, 2) AS revenue,\n       ROUND(100.0 * (revenue - LAG(revenue) OVER (ORDER BY year)) / LAG(revenue) OVER (ORDER BY year), 1) AS yoy_pct\nFROM h1\nORDER BY year;",
      "rows": 3,
      "result": [
        {
          "year": "2023",
          "orders": 252,
          "revenue": 286501.52,
          "yoy_pct": null
        },
        {
          "year": "2024",
          "orders": 237,
          "revenue": 257059.34,
          "yoy_pct": -10.3
        },
        {
          "year": "2025",
          "orders": 231,
          "revenue": 231882.85,
          "yoy_pct": -9.8
        }
      ]
    },
