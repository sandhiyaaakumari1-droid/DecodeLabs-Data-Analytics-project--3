    {
      "id": "Q19",
      "section": "E. HAVING and subqueries",
      "title": "Median order value in pure SQL",
      "question": "What is the typical (median) order value? SQLite has no MEDIAN(), so the middle row(s) are picked.",
      "sql": "SELECT ROUND(AVG(TotalPrice), 2) AS median_order_value\nFROM (\n    SELECT TotalPrice\n    FROM orders\n    ORDER BY TotalPrice\n    LIMIT 2 - (SELECT COUNT(*) FROM orders) % 2\n    OFFSET (SELECT (COUNT(*) - 1) / 2 FROM orders)\n);",
      "rows": 1,
      "result": [
